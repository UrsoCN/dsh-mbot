#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob globstar
umask 077
MBOT_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd -P)
source "$MBOT_ROOT/lib/config.sh"
source "$MBOT_ROOT/lib/shell-permit.sh"
mbot_import_shell_permit
source "$MBOT_ROOT/lib/ws.sh"
source "$MBOT_ROOT/lib/lint.sh"
source "$MBOT_ROOT/lib/board.sh"
source "$MBOT_ROOT/lib/guard.sh"
source "$MBOT_ROOT/lib/render.sh"
source "$MBOT_ROOT/lib/run.sh"
source "$MBOT_ROOT/lib/dream.sh"
source "$MBOT_ROOT/lib/schedule.sh"
source "$MBOT_ROOT/lib/ops.sh"
source "$MBOT_ROOT/lib/permit.sh"
if [[ ${1:-} == -C ]]; then
  [[ $# -ge 2 && -n $2 ]] || { mbot_error '-C requires a directory'; exit 2; }
  MBOT_CLI_WS=$2; shift 2
fi
case ${1:---help} in
  -h|--help) printf 'Usage: mbot [-C dir] init [dir]\n       mbot [-C dir] run [bot] "request" [--task id]\n       mbot [-C dir] tick|archive|dream|status|pause [reason]|resume|recover\n' ;;
  init) shift; mbot_init "$@" ;;
  recover) shift; [[ $# == 0 ]] || { mbot_error 'usage: mbot recover'; exit 2; }; mbot_select_workspace; "$MBOT_ROOT/bin/mbot-turn" -C "$MBOT_WS" --recover ;;
  run|tick|archive|dream|status|pause|resume)
    command=$1; shift
    if [[ ( $command == run || $command == tick || $command == archive || $command == dream ) && -v MBOT_RUN_ID ]]; then mbot_error "nested mbot $command is forbidden (MBOT_RUN_ID is set)"; exit 1; fi
    mbot_load_workspace
    [[ ! -v MBOT_PERMIT_TOKEN ]] || mbot_check_permit 0
    "mbot_$command" "$@" ;;
  *) mbot_error "unknown command: $1 (use --help)"; exit 2 ;;
esac
