#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob globstar
MBOT_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd -P)
source "$MBOT_ROOT/lib/config.sh"
source "$MBOT_ROOT/lib/shell-permit.sh"
mbot_import_shell_permit
source "$MBOT_ROOT/lib/ws.sh"
source "$MBOT_ROOT/lib/lint.sh"
source "$MBOT_ROOT/lib/board.sh"
source "$MBOT_ROOT/lib/permit.sh"
if [[ ${1:-} == -C ]]; then
  [[ $# -ge 2 && -n $2 ]] || { mbot_error '-C requires a directory'; exit 2; }
  MBOT_CLI_WS=$2; shift 2
fi
case ${1:-} in
  talk|receipt|runtime|stop|compact|bots|remove|removed|recover)
    if [[ -v MBOT_CLI_WS ]]; then
      printf '%s\n' 'mbot: Host commands use --bot and --profile, not -C' >&2
      exit 2
    fi
    exec node "$MBOT_ROOT/bin/botctl-host.mjs" "$@" ;;
esac
for arg in "$@"; do
  if [[ $arg == --help || $arg == -h ]]; then set -- --help; break; fi
done
case ${1:---help} in
  migrate-readonly)
    shift
    [[ -n ${MBOT_CLI_WS:-} ]] || { mbot_error 'migrate-readonly requires an explicit -C data directory'; exit 2; }
    exec node "$MBOT_ROOT/bin/botctl-migrate.mjs" --workspace "$MBOT_CLI_WS" "$@" ;;
  -h|--help)
    printf '%s\n' 'Usage: botctl [-C dir] boot <bot> [--task id]' \
      '       botctl [-C dir] board show|add|set ...' \
      '       botctl [-C dir] task show|result ...' \
      '       botctl [-C dir] remember "fact" [--as bot] [--task id]' \
      '       botctl [-C dir] lint' \
      '       botctl talk|receipt|runtime|stop|bots|remove|removed|recover --profile NAME ...' \
      '       botctl -C dir migrate-readonly [--session-root dir] [--check]' \
      '       botctl talk --help'
    exit 0 ;;
esac
mbot_load_workspace
if [[ ! -v MBOT_RUN_ID && ( ${1:-} == remember || ( ${1:-} == board && ${2:-} != show ) || ( ${1:-} == task && ${2:-} == result ) ) ]]; then
  exec 8> "$(mbot_path .mbot/lock)"
  flock -n 8 || { mbot_error 'a run is active; retry this human mutation after it finishes'; exit 1; }
fi
lock=$(mbot_path .mbot/botctl.lock)
exec 9> "$lock"
flock 9
mutation=1
if [[ ${1:-} == boot || ${1:-} == lint || ( ${1:-} == board && ${2:-} == show ) || ( ${1:-} == task && ${2:-} == show ) ]]; then mutation=0; fi
mbot_check_permit "$mutation"
mbot_check_command "$@"
command=${1:-}; shift || true
case $command in
  boot) mbot_boot "$@" ;;
  lint) [[ $# == 0 ]] || { mbot_error 'usage: botctl lint'; exit 2; }; mbot_lint ;;
  board|task|remember)
    case $command in
      board) mbot_board "$@" ;;
      task) mbot_task "$@" ;;
      remember) mbot_remember "$@" ;;
    esac ;;
  *) mbot_error "unknown command: $command (use --help)"; exit 2 ;;
esac
