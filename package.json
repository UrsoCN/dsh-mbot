{
  "name": "dsh-mbot",
  "version": "0.2.0-rc.1",
  "description": "Markdown and Git bot workspaces, Chief/Worker orchestration and Dreaming for DeepSeek Harness",
  "type": "module",
  "main": "./plugin/index.js",
  "types": "./plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./plugin/index.d.ts",
      "default": "./plugin/index.js"
    },
    "./tools": {
      "types": "./plugin/tools.d.ts",
      "default": "./plugin/tools.js"
    },
    "./commands": {
      "types": "./plugin/commands.d.ts",
      "default": "./plugin/commands.js"
    },
    "./client": {
      "types": "./plugin/client.d.ts",
      "default": "./plugin/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./runtime": {
      "types": "./plugin/runtime.d.ts",
      "default": "./plugin/runtime.js"
    },
    "./ipc": {
      "types": "./plugin/ipc.d.ts",
      "default": "./plugin/ipc.js"
    }
  },
  "bin": {
    "mbot": "./bin/mbot",
    "botctl": "./bin/botctl"
  },
  "files": [
    "AGENTS.md",
    "plugin",
    "bin",
    "lib",
    "templates",
    "prompts",
    "patches",
    "ops",
    "cron",
    "locale",
    "cordis.patch.yml",
    "install.sh",
    "docs"
  ],
  "scripts": {
    "test": "npm run check:types && node --test --test-concurrency=1 tests/plugin.test.js tests/runtime.test.js && bash tests/run.sh",
    "test:plugin": "node --test tests/plugin.test.js",
    "test:gui": "node tests/gui-plugin.mjs",
    "check:types": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 tests/plugin-types.ts",
    "test:install": "bash tests/install-plugin.sh",
    "test:real-plugin": "bash tests/real-plugin.sh",
    "test:real-compaction": "bash tests/real-compaction.sh",
    "test:runtime": "node --test tests/runtime.test.js",
    "test:gui-runtime": "node tests/gui-runtime.mjs",
    "test:gui-compaction": "node tests/gui-compaction.mjs",
    "test:gui-migration": "node tests/gui-migration.mjs",
    "test:gui-handoff": "node tests/gui-handoff.mjs",
    "bench:runtime": "node tests/bench-runtime.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-command-compact": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-shell-env": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5",
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "external": [
        "react/jsx-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "linux",
        "wsl"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrsoCN/dsh-mbot.git"
  },
  "homepage": "https://github.com/UrsoCN/dsh-mbot#readme",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "bots",
    "memory",
    "markdown"
  ],
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  }
}
