#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob
framework=${MBOT_DSH%/tests/fake-dsh}
original_args=("$@")
[[ $1 == --profile && $2 == headless && $3 == --patch ]]
if [[ ${MBOT_MODE:-run} == dream ]]; then [[ $4 == "$framework/patches/dream.yml" ]]; else [[ $4 == "$framework/patches/run.yml" ]]; fi
shift 4
seen_grants=()
while [[ ${1:-} == --add-dir ]]; do
  [[ $# -ge 2 && -d $2 && $2 == /* && $2 == "$(realpath -e "$2")" ]]
  seen_grants+=("$2"); shift 2
done
[[ $* == '--json --permission-mode workspace-write --approval-policy never -' ]]
if [[ ${MBOT_MODE:-run} == dream ]]; then [[ ${#seen_grants[@]} == 0 ]]; else
  [[ $(IFS=:; printf '%s' "${seen_grants[*]}") == "${MBOT_GRANTS:-}" ]]
fi
[[ -n ${MBOT_RUN_ID:-} && -n ${MBOT_BOT:-} && $MBOT_WS == "$(pwd -P)" ]]
prompt=$(cat)
[[ $prompt == *'MEMORY.md'* ]]
[[ ${MBOT_MODE:-run} == dream || $prompt == *'<request>'* ]]
[[ $(command -v botctl) == "${MBOT_DSH%/tests/fake-dsh}/bin/botctl" ]]
[[ ${MBOT_FAKE_ARTIFACTS:-} == /tmp/* ]]
mkdir -p "$MBOT_FAKE_ARTIFACTS"
printf '%s\0' "${original_args[@]}" > "$MBOT_FAKE_ARTIFACTS/argv"
printf '%s\n' "$prompt" > "$MBOT_FAKE_ARTIFACTS/prompt"
printf '%s\n' "$MBOT_RUN_ID" >> "$MBOT_FAKE_ARTIFACTS/invocations"
printf '{"type":"session","sessionId":"fake-session"}\n'
text='fake completed'
if [[ ${MBOT_MODE:-run} == dream ]]; then
  report=$(sed -n 's/^本次唯一报告路径：//p' <<< "$prompt")
  [[ $report == dream-reports/*-dream-*.md && $report != *$'\n'* ]]
  mkdir -p dream-reports
  case ${MBOT_FAKE_MODE:-dream-normal} in
    dream-normal|dream-board|dream-secret)
      printf '\n- 周报一律使用中文 [source: inbox/%s.md; added: %s]\n' "$(date +%F)" "$(date +%F)" >> MEMORY.md
      ;;
    dream-private-large) printf '%s\n' {1..151} > bots/coder/MEMORY.md ;;
    dream-wiki-large) printf '%s\n' {1..201} > wiki/large.md ;;
    dream-wiki-no-basis) rm wiki/obsolete.md ;;
    dream-large) printf '%s\n' {1..151} > MEMORY.md ;;
    dream-link) printf '\n- [[wiki/missing.md]]\n' >> MEMORY.md ;;
    dream-delete|dream-no-basis|dream-empty-basis|dream-wrong-basis|dream-index-delete)
      printf '# 共享记忆\n\n- 周报一律使用中文 [source: inbox/%s.md; added: %s]\n' "$(date +%F)" "$(date +%F)" > MEMORY.md
      ;;
    dream-missing|dream-directory|dream-error) printf '\n- failed candidate\n' >> MEMORY.md ;;
    dream-noop|slow) ;;
    *) exit 8 ;;
  esac
  if [[ ${MBOT_FAKE_MODE:-} == dream-normal ]]; then
    printf '\n- 编码结果附验收证据 [source: inbox/%s.md; added: %s]\n' "$(date +%F)" "$(date +%F)" >> bots/coder/MEMORY.md
    printf '# 周报格式\n\n周报一律使用中文。\n' > wiki/weekly.md
    printf '\n- 周报格式见 [[wiki/weekly.md]]\n' >> wiki/_index.md
  fi
  if [[ ${MBOT_FAKE_MODE:-} == dream-delete ]]; then rm -f wiki/obsolete.md; fi
  if [[ ${MBOT_FAKE_MODE:-} == dream-index-delete ]]; then rm wiki/_index.md; fi
  if [[ ${MBOT_FAKE_MODE:-} == dream-board ]]; then botctl board add 'dream must not touch board' >/dev/null; fi
  if [[ ${MBOT_FAKE_MODE:-} == dream-directory ]]; then mkdir -p "$report"; fi
  if [[ ${MBOT_FAKE_MODE:-} != dream-missing && ${MBOT_FAKE_MODE:-} != dream-directory ]]; then
    printf '# Dreaming\n\n## 新增\n- MEMORY.md：中文周报，来源：inbox/%s.md\n## 修改\n无\n## 删除\n' "$(date +%F)" > "$report"
    case ${MBOT_FAKE_MODE:-} in
      dream-delete) printf -- '- MEMORY.md：整理旧说明；依据：inbox/%s.md 的用户偏好\n- wiki/obsolete.md：删除过时页面；依据：MEMORY.md 已整理规则\n' "$(date +%F)" >> "$report" ;;
      dream-empty-basis) printf -- '- MEMORY.md：删除旧说明；依据：\n' >> "$report" ;;
      dream-wrong-basis) printf -- '- bots/coder/MEMORY.md：另一文件的说明；依据：inbox 候选\n' >> "$report" ;;
      dream-index-delete) printf -- '- MEMORY.md：替换旧说明；依据：inbox 用户偏好\n- wiki/_index.md：删除空索引；依据：MEMORY.md 不再引用\n' >> "$report" ;;
      *) printf '无\n' >> "$report" ;;
    esac
    printf '## 丢弃的候选\n无\n## 待裁决\n无\n' >> "$report"
    [[ ${MBOT_FAKE_MODE:-} != dream-secret ]] || printf '%s\n' "$MBOT_TEST_SECRET" >> "$report"
  fi
  if [[ ${MBOT_FAKE_MODE:-} == dream-error ]]; then printf '{"type":"final","reason":{"kind":"error"},"text":"dream failed"}\n'; exit 1; fi
  if [[ ${MBOT_FAKE_MODE:-} == slow ]]; then printf 'started\n' > "$MBOT_FAKE_ARTIFACTS/started"; sleep 2; fi
  printf '{"type":"status","phase":"step_end","usage":{"inputTokens":10,"outputTokens":5,"cacheReadTokens":50,"totalTokens":65}}\n'
  printf '{"type":"final","sessionId":"fake-dream","reason":{"kind":"completed"},"text":"dream complete"}\n'
  exit 0
fi
case ${MBOT_FAKE_MODE:-add} in
  add)
    printf '{"type":"tool_call","callId":"add","tool":"bash","input":{"command":"botctl board add"}}\n'
    id=$(botctl board add '整理 README')
    printf '%s' "$id" | jq -Rs '{type:"tool_result",callId:"add",status:"completed",result:.}'
    ;;
  memory)
    botctl board add '合法任务' >/dev/null
    printf 'rogue\n' >> MEMORY.md
    printf 'rogue\n' >> bots/coder/MEMORY.md
    printf 'rogue\n' >> bots/chief/SOUL.md
    printf 'rogue\n' >> AGENTS.md
    printf 'rogue\n' > wiki/rogue.md
    printf 'rogue\n' > unexpected.txt
    ;;
  inbox-delete) printf 'rewritten\n' > "inbox/$(date +%F).md" ;;
  remember) botctl remember '中文周报' --as chief --task 001 >/dev/null ;;
  bad-board)
    botctl board add '应回滚的任务' >/dev/null
    printf '| bogus | oops |\n' >> BOARD.md
    ;;
  history)
    for file in transcripts/*/*.md; do printf 'forged\n' > "$file"; done
    mkdir -p transcripts/2000-01-01
    printf 'forged\n' > transcripts/2000-01-01/forged.md
    for file in .mbot/runs/*.jsonl; do printf 'forged\n' > "$file"; done
    printf '999\n' > .mbot/failures
    printf 'rogue\n' > .env.rogue
    ;;
  symlink)
    mkdir -p "$MBOT_FAKE_ARTIFACTS/outside"
    printf 'outside-original\n' > "$MBOT_FAKE_ARTIFACTS/outside/001.md"
    mv tasks tasks-rogue
    ln -s "$MBOT_FAKE_ARTIFACTS/outside" tasks
    ;;
  head)
    printf 'rogue\n' >> MEMORY.md
    git add MEMORY.md
    git commit -qm 'rogue agent commit'
    ;;
  control)
    printf 'outside-original\n' > "$MBOT_FAKE_ARTIFACTS/control-target"
    ln -s "$MBOT_FAKE_ARTIFACTS/control-target" .mbot/PAUSED
    ;;
  git-destroy) mv .git .git.broken ;;
  nested)
    if mbot run chief 'nested forbidden' > "$MBOT_FAKE_ARTIFACTS/nested" 2>&1; then exit 9; fi
    ;;
  slow) printf 'started\n' > "$MBOT_FAKE_ARTIFACTS/started"; sleep 2 ;;
  timeout) sleep 10 ;;
  secret)
    printf '%s\n' "$MBOT_TEST_SECRET" >&2
    text="done $MBOT_TEST_SECRET sk-TESTPATTERN12345678901234567890 Bearer testbearersecret123456"
    ;;
  incomplete) exit 0 ;;
  wrong-final) printf '{"type":"final","reason":"invalid reason","text":"failed"}\n'; exit 0 ;;
  malformed) printf 'invalid JSON\n'; exit 0 ;;
  error)
    printf '{"type":"final","sessionId":"fake-session","reason":{"kind":"error","code":"FAKE_FAILURE"},"text":"failed"}\n'
    exit 1 ;;
  noop) ;;
  tick)
    id=$(sed -n 's/^<context file="tasks\/\([0-9]*\).md">$/\1/p' <<< "$prompt")
    [[ -n $id ]]
    printf 'tick verification passed\n' | botctl task result "$id" --as coder >/dev/null
    botctl board set "$id" done >/dev/null
    ;;
  grant)
    for dir in "${seen_grants[@]}"; do printf 'grant-used\n' > "$dir/grant-marker"; done
    ;;
  respect)
    if [[ ${MBOT_TEST_EXPECT_RULE:-1} == 1 ]]; then [[ $prompt == *'周报一律使用中文'* ]]; else [[ $prompt != *'周报一律使用中文'* ]]; fi
    text='memory expectation verified'
    ;;
  *) exit 8 ;;
esac
printf '{"type":"status","phase":"step_end","usage":{"inputTokens":10,"outputTokens":5,"cacheReadTokens":50,"cacheWriteTokens":0,"totalTokens":65}}\n'
printf '%s' "$text" | jq -Rs '{type:"final",sessionId:"fake-session",reason:{kind:"completed"},text:.}'
